# ==============================================================================
# CRAVE HOUSE / WHITE-LABEL RESTAURANT DEPLOYMENT CONFIGURATION
# ==============================================================================

# ── 1. Server & Environment ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Reverse proxy trust depth (1 for Render/standard load balancer; defaults to 1 when RENDER=true or NODE_ENV=production)
TRUST_PROXY=1

# ── 2. Database Connection (Per-Restaurant Isolated MongoDB Database) ─────────
# Canonical: MONGODB_URI (Backward-compatible alias: MONGO_URI)
MONGODB_URI=mongodb://127.0.0.1:27017/crave_house

# ── 3. Authentication & Security (Server-Only Secrets) ─────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d

# ── 4. Payment Gateway (Razorpay - Keep Secret Exclusively on Backend) ────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ── 5. Restaurant Identity & Branding (Optional White-label Overrides) ────────
RESTAURANT_NAME=Crave House
RESTAURANT_SHORT_NAME=CH
RESTAURANT_TAGLINE=Delicious food, delivered fast.
RESTAURANT_DESCRIPTION=Fresh ingredients. Fast delivery. Premium taste. Made with love.
RESTAURANT_SINCE_YEAR=2016
# RESTAURANT_LOGO_URL=/src/assets/images/logo.png
# RESTAURANT_FAVICON_URL=/favicon.ico

# ── 6. Visual Theme Colors (Hex tokens injected into CSS custom properties) ───
# THEME_PRIMARY=#4e342e
# THEME_DARK=#241713
# THEME_SECONDARY=#6d4c41
# THEME_CREAM=#f8f5ed
# THEME_BEIGE=#efe7dd
# THEME_ACCENT=#d4a373

# ── 7. Contact Details & Address (Use Obvious Placeholders in Templates) ───────
# Canonical: CONTACT_PHONE, CONTACT_EMAIL, CONTACT_STREET, etc.
# Aliases also supported: RESTAURANT_CONTACT_PHONE, RESTAURANT_CONTACT_EMAIL, RESTAURANT_ADDRESS_*
CONTACT_PHONE=+91 00000 00000
CONTACT_EMAIL=contact@example.com
CONTACT_STREET=123 Restaurant Street
CONTACT_CITY=City
CONTACT_STATE=State
CONTACT_PINCODE=000000
CONTACT_COUNTRY=India
PICKUP_LOCATION_NAME=Main Restaurant Location

# ── 8. Business Operating Hours (Enforced authoritatively by backend) ──────────
# Canonical 24-hour integer format: 0 to 23 (e.g. 10 for 10:00 AM, 22 for 10:00 PM)
BUSINESS_HOURS_WEEKDAY_OPEN=10
BUSINESS_HOURS_WEEKDAY_CLOSE=22
BUSINESS_HOURS_WEEKEND_OPEN=9
BUSINESS_HOURS_WEEKEND_CLOSE=23
# Backward-compatible alternate names also accepted:
# WEEKDAY_OPEN_TIME=10
# WEEKDAY_CLOSE_TIME=22
# WEEKEND_OPEN_TIME=9
# WEEKEND_CLOSE_TIME=23

# ── 9. Table Reservation Settings ─────────────────────────────────────────────
DEFAULT_SLOT_DURATION_MINUTES=90
MAX_PARTY_SIZE=20

# ── 10. Currency, Locale & Tax Display ────────────────────────────────────────
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
LOCALE=en-IN

# ── 11. Social Links ──────────────────────────────────────────────────────────
SOCIAL_INSTAGRAM=https://instagram.com/yourrestaurant
SOCIAL_FACEBOOK=https://facebook.com/yourrestaurant
SOCIAL_TWITTER=https://twitter.com/yourrestaurant

# ── 12. Transactional Email Notifications (Server-Only Credentials) ───────────
# Canonical active provider: EMAIL_PROVIDER ('smtp', 'mock', or 'none')
# Compatibility flag: EMAIL_SERVICE_ENABLED=true/false
EMAIL_PROVIDER=smtp

# SMTP Provider Settings (e.g., Mailtrap, SendGrid, Amazon SES, Brevo)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Sender address display (falls back to RESTAURANT_NAME and CONTACT_EMAIL if omitted)
# Canonical: EMAIL_FROM="Restaurant Name" <orders@example.com>
# Aliases: SMTP_FROM_NAME and SMTP_FROM_EMAIL
EMAIL_FROM="Restaurant Name" <orders@example.com>

# ── 13. Production Email Retry Runner (Periodic In-Process Worker) ─────────────
# Enable periodic retry worker for failed notifications (default: true)
EMAIL_RETRY_ENABLED=true
# Interval between retry runs in milliseconds (default: 300000 = 5 minutes)
EMAIL_RETRY_INTERVAL_MS=300000
# Maximum retry attempts per notification before marking permanently failed (default: 3)
EMAIL_RETRY_MAX_ATTEMPTS=3

# ── 14. Initial Privileged User Seeding (Optional Admin/Owner Bootstrap) ──────
# Used only when running 'npm run seed:users' to provision initial staff
# In production (NODE_ENV=production), custom non-default passwords are strictly required
# SEED_ADMIN_NAME="Restaurant Admin"
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=strong_random_admin_password
# SEED_OWNER_NAME="Restaurant Owner"
# SEED_OWNER_EMAIL=owner@yourdomain.com
# SEED_OWNER_PASSWORD=strong_random_owner_password
